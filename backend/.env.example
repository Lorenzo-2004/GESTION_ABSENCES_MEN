# Copier ce fichier en .env et adapter les valeurs
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Origines de confiance pour le CSRF (vide en développement : CORS est déjà ouvert).
DJANGO_CSRF_TRUSTED_ORIGINS=
# PostgreSQL (laisser DB_NAME vide pour utiliser SQLite en développement rapide)
DB_NAME=men_absences
DB_USER=postgres
DB_PASSWORD=change-me
DB_HOST=localhost
DB_PORT=5432
DB_CONN_MAX_AGE=60
# Active en développement/production les délais réglementaires RG-11 (true par défaut)
MEN_APPLIQUER_DELAIS_REGLEMENTAIRES=True

# Durée maximale absolue d'une session authentifiée et durée du jeton d'accès
MEN_SESSION_MAX_HOURS=8
MEN_ACCESS_TOKEN_MINUTES=15

# Cache partagé optionnel (utile avec plusieurs workers de production).
# Décommentez ces deux lignes puis exécutez :
# python manage.py createcachetable men_rate_limit_cache
# DJANGO_CACHE_BACKEND=django.core.cache.backends.db.DatabaseCache
# DJANGO_CACHE_LOCATION=men_rate_limit_cache
